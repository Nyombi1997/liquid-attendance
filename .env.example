# Copier en .env puis remplacer les mots de passe : cp .env.example .env
APP_NAME="Liquid Présence"
APP_URL=https://41.174.155.178:8443
APP_TIMEZONE=Africa/Kinshasa
# Adresse publique pour laquelle le certificat est demandé
PUBLIC_IP=41.174.155.178

DB_HOST=db
DB_NAME=liquid_attendance
DB_USER=liquid
DB_PASSWORD=change-moi-mot-de-passe-long
DB_ROOT_PASSWORD=change-moi-aussi-root

# Les badges arrivent en temps réel. Synchronisation complète (utilisateurs,
# tous les pointages, horloge) sur la connexion ouverte, en secondes :
FULL_SYNC_INTERVAL=1800
# Calcul global des journées, en filet de sécurité (secondes)
SYNC_INTERVAL=300
# Nombre de jours recalculés à chaque calcul global
COMPUTE_DAYS=7
# Remise à l'heure des pointeuses chaque nuit (heure de la VM) ; off pour désactiver
CLOCK_SET_AT=03:00
