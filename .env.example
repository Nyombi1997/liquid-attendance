# Copier en .env puis remplacer les mots de passe : cp .env.example .env
APP_NAME="Liquid Présence"
APP_URL=https://41.174.155.178:8443
APP_TIMEZONE=Africa/Kinshasa
# Adresse publique pour laquelle le certificat est demandé
PUBLIC_IP=41.174.155.178

DB_HOST=db
DB_NAME=liquid_attendance
DB_USER=liquid
DB_PASSWORD=change-moi-mot-de-passe-long
DB_ROOT_PASSWORD=change-moi-aussi-root

# Les badges arrivent en temps réel. Synchronisation complète (utilisateurs,
# tous les pointages, horloge) sur la connexion ouverte, en secondes :
FULL_SYNC_INTERVAL=1800
# Calcul global des journées, en filet de sécurité (secondes)
SYNC_INTERVAL=300
# Nombre de jours recalculés à chaque calcul global
COMPUTE_DAYS=7
# Remise à l'heure des pointeuses chaque nuit (heure de la VM) ; off pour désactiver
CLOCK_SET_AT=03:00
# Au démarrage du service, remise à l'heure si l'écart dépasse (secondes)
CLOCK_MAX_DRIFT=30
# Pointeuses lentes (F16 du NOC et de l'IT Room) : délai d'attente plus long
# (secondes) et journal détaillé
SLOW_DEVICES=10.0.4.4,10.0.4.5
SLOW_TIMEOUT=60
# Après MAX_FAILURES échecs de connexion de suite, une tentative toutes les
# FAILED_RETRY_DELAY secondes
MAX_FAILURES=5
FAILED_RETRY_DELAY=1800

# Sauvegarde nocturne de la base (mariadb-dump compressé dans ./data/backups) ;
# off pour désactiver
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14

# Parc automobile : e-mails des notifications (demande reçue, approuvée, refusée,
# véhicule affecté, rappel avant le départ). Laisser SMTP_HOST vide pour ne rien
# envoyer (notifications dans l'application seulement).
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) ou none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Liquid Présence"
# Tâches du parc automobile dans le worker (rappels, alertes d'expiration,
# envoi des e-mails), en secondes ; 0 pour désactiver
FLEET_TASKS_INTERVAL=60
